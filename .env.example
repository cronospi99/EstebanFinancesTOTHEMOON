# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Sin estas variables la app arranca igual, en "Modo Demo" (datos locales).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Market data (opcional). El proxy /api/quotes usa Yahoo Finance sin llave.
# Alpha Vantage se usa solo como respaldo si defines la llave.
# NUNCA se expone al cliente: se queda en el servidor.
# ---------------------------------------------------------------------------
ALPHA_VANTAGE_API_KEY=
