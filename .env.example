# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# Sin estas variables la app arranca igual, en "Modo Demo" (datos locales).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Datos de mercado. /api/quotes y /api/history prueban primero las fuentes sin
# llave (Yahoo, Coinbase para cripto, Stooq), pero desde un centro de datos
# suelen fallar: Yahoo responde 429 a las IP de Vercel y Stooq devuelve una
# página HTML en vez del CSV. Ahí entra Twelve Data, cuyo plan gratuito da
# 800 llamadas al día y cubre precio e histórico con la misma llave.
#
#   https://twelvedata.com  →  API Key
#
# Ninguna se expone al cliente: viven solo en el servidor.
# ---------------------------------------------------------------------------
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
